# Copy to .env (or set in your host's dashboard). Never commit real values.
PORT=3000
# Admin password used on the FIRST run only. If empty, a random one is printed to the console.
ADMIN_PASSWORD=
# Where the SQLite database and uploaded files live. Mount a persistent disk here in production.
DATA_DIR=./data
# Set to 1 when the site is served over HTTPS (adds the Secure flag to the admin cookie).
COOKIE_SECURE=0
